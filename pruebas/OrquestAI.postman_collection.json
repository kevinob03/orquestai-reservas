{
  "info": { "name": "OrquestAI Reservas - evidencia API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000/api" }],
  "item": [
    { "name": "200 Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
    { "name": "Mesas - CRUD completo", "item": [
      { "name": "200 Listar mesas", "request": { "method": "GET", "url": "{{baseUrl}}/mesas" } },
      { "name": "200 Detalle mesa relacionada", "request": { "method": "GET", "url": "{{baseUrl}}/mesas/1" } },
      { "name": "201 Crear mesa", "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 creado', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('mesaPruebaId', pm.response.json().id);"] } }], "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"numero\":99,\"capacidad\":2,\"ubicacion\":\"prueba\"}" }, "url": "{{baseUrl}}/mesas" } },
      { "name": "200 Editar mesa", "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"numero\":99,\"capacidad\":4,\"ubicacion\":\"prueba\",\"activa\":true}" }, "url": "{{baseUrl}}/mesas/{{mesaPruebaId}}" } },
      { "name": "200 Eliminar mesa", "request": { "method": "DELETE", "url": "{{baseUrl}}/mesas/{{mesaPruebaId}}" } },
      { "name": "400 Mesa invalida", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"numero\":0,\"capacidad\":0}" }, "url": "{{baseUrl}}/mesas" } }
    ] },
    { "name": "Clientes - CRUD completo", "item": [
      { "name": "200 Listar clientes", "request": { "method": "GET", "url": "{{baseUrl}}/clientes" } },
      { "name": "201 Crear cliente", "event": [{ "listen": "test", "script": { "exec": ["pm.test('201 creado', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('clientePruebaId', pm.response.json().id);"] } }], "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"nombre\":\"Cliente Prueba\",\"telefono\":\"88889999\"}" }, "url": "{{baseUrl}}/clientes" } },
      { "name": "200 Editar cliente", "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"nombre\":\"Cliente Prueba Editado\",\"telefono\":\"88889998\"}" }, "url": "{{baseUrl}}/clientes/{{clientePruebaId}}" } },
      { "name": "200 Eliminar cliente", "request": { "method": "DELETE", "url": "{{baseUrl}}/clientes/{{clientePruebaId}}" } },
      { "name": "404 Cliente inexistente", "request": { "method": "GET", "url": "{{baseUrl}}/clientes/999999" } }
    ] },
    { "name": "Reservas y reglas", "item": [
      { "name": "200 Resumen", "request": { "method": "GET", "url": "{{baseUrl}}/resumen" } },
      { "name": "200 Disponibilidad", "request": { "method": "GET", "url": "{{baseUrl}}/disponibilidad?fecha=2026-10-23&hora_inicio=13:00&personas=4" } },
      { "name": "200 Listar reservas", "request": { "method": "GET", "url": "{{baseUrl}}/reservas" } },
      { "name": "409 Fuera de horario", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"cliente_id\":1,\"mesa_id\":1,\"fecha\":\"2026-10-25\",\"hora_inicio\":\"20:00\",\"personas\":2}" }, "url": "{{baseUrl}}/reservas" } }
    ] }
  ]
}
